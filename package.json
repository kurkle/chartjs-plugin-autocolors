{
  "author": "Jukka Kurkela <jukka.kurkela@gmail.com>",
  "bugs": {
    "url": "https://github.com/kurkle/chartjs-plugin-autocolors/issues"
  },
  "description": "Automatic color generation for Chart.js",
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/starlight": "^0.42.0",
    "@biomejs/biome": "^2.5.12",
    "@kurkle/astro-chartjs-editor": "^1.0.0",
    "@kurkle/color": "^0.5.1",
    "@kurkle/configs": "^1.5.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "astro": "^7.0.6",
    "chart.js": "^4.4.5",
    "cookie": "^2.0.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "rollup": "^4.21.2",
    "semantic-release": "^25.0.3",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "exports": {
    "import": "./dist/chartjs-plugin-autocolors.esm.js",
    "require": "./dist/chartjs-plugin-autocolors.cjs",
    "script": "./dist/chartjs-plugin-autocolors.min.js",
    "types": "./types/index.esm.d.ts"
  },
  "files": [
    "dist/*",
    "!dist/docs/**",
    "types/index.esm.d.ts"
  ],
  "homepage": "https://github.com/kurkle/chartjs-plugin-autocolors#readme",
  "jsdelivr": "dist/chartjs-plugin-autocolors.min.js",
  "keywords": [
    "chart.js",
    "plugin",
    "color",
    "palette",
    "generator",
    "auto"
  ],
  "license": "MIT",
  "main": "dist/chartjs-plugin-autocolors.cjs",
  "module": "dist/chartjs-plugin-autocolors.esm.js",
  "name": "chartjs-plugin-autocolors",
  "peerDependencies": {
    "@kurkle/color": ">=0.3.0",
    "chart.js": ">=2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurkle/chartjs-plugin-autocolors.git"
  },
  "scripts": {
    "autobuild": "rollup -c -w",
    "build": "rollup -c",
    "dev": "vitest --config vitest.browser.config.ts",
    "docs": "npm run build && astro build",
    "docs:dev": "npm run build && astro dev",
    "docs:version": "node ./docs/scripts/write-docs-version.cjs",
    "fixtures:update": "node scripts/update-fixtures.mjs",
    "format": "biome check --write",
    "icons": "kurkle-generate-icons",
    "lint": "biome check",
    "predocs": "npm run docs:version",
    "predocs:dev": "npm run docs:version",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "npm run test:fixture",
    "test:fixture": "vitest run --config vitest.browser.config.ts --coverage",
    "typecheck": "tsc -p types/tests/ && tsc --noEmit -p tsconfig.tooling.json",
    "typecheck:docs": "astro check"
  },
  "sideEffects": false,
  "type": "module",
  "types": "types/index.esm.d.ts",
  "unpkg": "dist/chartjs-plugin-autocolors.min.js",
  "version": "0.0.0-development"
}
