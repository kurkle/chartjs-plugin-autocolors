{
  "compilerOptions": {
    /* JavaScript Support */
    "allowJs": true,
    "alwaysStrict": true,

    /* Modules */
    "checkJs": true,
    "lib": ["es2018", "DOM"],
    "module": "ES6",
    "moduleResolution": "Bundler",

    /* Emit */
    "noEmit": true,

    /* Completeness */
    // False, not true: skipLibCheck also skips checking the .d.ts files this
    // package ships, which is exactly what let an undeclared `autocolorPlugin`
    // name go unnoticed in types/index.esm.d.ts. Keep it off so a broken
    // hand-written declaration fails typecheck instead of only failing at
    // runtime for a downstream consumer who has skipLibCheck: false.
    "skipLibCheck": false,
    /* Type Checking */
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,

    /* Language and Environment */
    "target": "ESNext"
  },
  "include": ["../index.esm.d.ts", "./**/*.ts"]
}
