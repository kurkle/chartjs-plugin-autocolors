{
  "compilerOptions": {
    /* JavaScript Support */
    "allowJs": true,
    "alwaysStrict": true,

    /* Modules */
    "baseUrl": ".",
    "checkJs": true,
    "lib": ["es2018", "DOM"],
    "module": "ES6",
    "moduleResolution": "Node",

    /* Emit */
    "noEmit": true,

    /* Completeness */
    "skipLibCheck": true,
    /* Type Checking */
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,

    /* Language and Environment */
    "target": "ESNext"
  },
  "include": ["../index.esm.d.ts", "./**/*.ts"]
}
